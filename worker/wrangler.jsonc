// The multiplayer server. One Durable Object per room, keyed by its code,
// holding the room in its own SQLite storage: a Room shares a Scores-tab
// game; a Table plays online hands.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mjwaits-mp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Served at its own subdomain of kevinlhc.com (a Custom Domain: Cloudflare
  // makes the DNS record and certificate on the first deploy).
  "routes": [{ "pattern": "mj-api.kevinlhc.com", "custom_domain": true }],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "TABLES", "class_name": "Table" }
    ]
  },
  // SQLite-backed Durable Objects are the ones the Workers free plan offers.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Table"] }
  ],
  "vars": {
    // Pages allowed to connect, comma-separated, besides localhost (always
    // allowed, for development). Override for a LAN test in .dev.vars.
    "ALLOWED_ORIGINS": "https://app.kevinlhc.com"
  }
}
