{
  "name": "mjwaits",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "shared",
    "worker"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run && npm test --workspace worker",
    "arena": "vite build --ssr scripts/arena.ts --outDir .arena --emptyOutDir --logLevel warn && node .arena/arena.js",
    "evolve": "vite build --ssr scripts/evolve.ts --outDir .evolve --emptyOutDir --logLevel warn && node .evolve/evolve.js",
    "ml-data": "vite build --ssr scripts/ml-data.ts --outDir .ml-data --emptyOutDir --logLevel warn && node .ml-data/ml-data.js",
    "ml-eval": "vite build --ssr scripts/ml-eval.ts --outDir .ml-eval --emptyOutDir --logLevel warn && node .ml-eval/ml-eval.js",
    "ml-selfplay": "vite build --ssr scripts/ml-selfplay.ts --outDir .ml-selfplay --emptyOutDir --logLevel warn && node .ml-selfplay/ml-selfplay.js",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@mjwaits/shared": "*",
    "onnxruntime-web": "^1.27.0",
    "qrcode-generator": "2.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
